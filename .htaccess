# Clean URLs for Takees Cowork (Hostinger)
RewriteEngine On

# Old blog address -> new article address
RewriteRule ^blog\.html$ /places-to-visit-in-Kannur [R=301,L]

# Hide .html in the address bar: /index.html -> /, /blogs.html -> /blogs
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Old /home address -> just the domain
RewriteRule ^home$ / [R=301,L]

# Blog address ending in a slash: /why-people-are-switching-their-workspace-from-home/
RewriteRule ^why-people-are-switching-their-workspace-from-home$ /why-people-are-switching-their-workspace-from-home/ [R=301,L]
RewriteRule ^why-people-are-switching-their-workspace-from-home/$ why-people-are-switching-their-workspace-from-home.html [L]

# Homepage sections: /about /amenities /plan /places /contact
RewriteRule ^(about|amenities|plan|places|contact)$ index.html [L]

# Serve the page for the clean address: /blogs -> blogs.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/.]+)$ $1.html [L]

# Always check for the newest version of pages after an update (photos stay cached for speed)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
